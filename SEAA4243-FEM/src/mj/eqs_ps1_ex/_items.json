[{"name": "u1_proc", "tex": "\\begin{aligned}&(1)\\ \\text{local }(x,y)\\text{ of the point in its element}\\\\&(2)\\ N_i(x,y):\\quad u=\\textstyle\\sum N_iu_i,\\quad v=\\sum N_iv_i\\\\&(3)\\ \\varepsilon_{xx}=\\dfrac{\\partial u}{\\partial x},\\quad\\varepsilon_{yy}=\\dfrac{\\partial v}{\\partial y},\\quad\\varepsilon_{xy}=\\dfrac{\\partial u}{\\partial y}+\\dfrac{\\partial v}{\\partial x}\\\\&(4)\\ \\{\\sigma\\}^{\\mathsf T}=[E]\\{\\varepsilon\\}^{\\mathsf T}\\end{aligned}", "em": 44, "color": "#1b2330"}, {"name": "u1_deriv", "tex": "\\begin{aligned}\\frac{\\partial u}{\\partial x}&=\\sum\\frac{\\partial N_i}{\\partial x}u_i=\\frac{(b-y)(u_2-u_1)+y\\,(u_3-u_4)}{ab}\\\\[4pt]\\frac{\\partial v}{\\partial y}&=\\frac{(a-x)(v_4-v_1)+x\\,(v_3-v_2)}{ab}\\\\[4pt]\\frac{\\partial u}{\\partial y}&=\\frac{(a-x)(u_4-u_1)+x\\,(u_3-u_2)}{ab},\\qquad\\frac{\\partial v}{\\partial x}=\\frac{(b-y)(v_2-v_1)+y\\,(v_3-v_4)}{ab}\\end{aligned}", "em": 44, "color": "#1b2330"}, {"name": "u1_epsc", "tex": "\\begin{aligned}\\varepsilon_{xx}&=\\frac{(u_2-u_1)+(u_3-u_4)}{2a}=\\frac{(2-1)+(2-1)}{1.2}\\times10^{-5}=1.6667\\times10^{-5}\\\\[4pt]\\varepsilon_{yy}&=\\frac{(v_4-v_1)+(v_3-v_2)}{2b}=\\frac{(0-0.1)+(0-0.1)}{0.8}\\times10^{-5}=-2.5\\times10^{-6}\\\\[4pt]\\varepsilon_{xy}&=\\frac{(u_4-u_1)+(u_3-u_2)}{2b}+\\frac{(v_2-v_1)+(v_3-v_4)}{2a}=0+0=0\\end{aligned}", "em": 44, "color": "#1b2330"}, {"name": "u1_sigc", "tex": "\\begin{aligned}\\bar E&=\\frac{E}{1-\\nu^2}=\\frac{200\\times10^{6}}{0.91}=219.78\\times10^{6}\\ \\mathrm{kN/m^2}\\\\[4pt]\\sigma_{xx}&=\\bar E\\,(\\varepsilon_{xx}+\\nu\\varepsilon_{yy})=219.78\\times10^{6}\\,(1.6667\\times10^{-5}-0.3\\times2.5\\times10^{-6})=3498\\ \\mathrm{kN/m^2}\\\\\\sigma_{yy}&=\\bar E\\,(\\nu\\varepsilon_{xx}+\\varepsilon_{yy})=219.78\\times10^{6}\\,(0.3\\times1.6667\\times10^{-5}-2.5\\times10^{-6})=549\\ \\mathrm{kN/m^2}\\\\\\sigma_{xy}&=\\bar E\\,\\tfrac{1-\\nu}{2}\\,\\varepsilon_{xy}=0\\end{aligned}", "em": 44, "color": "#1b2330"}, {"name": "u1_Np", "tex": "\\begin{aligned}ab&=0.24:\\qquad N_1=\\frac{0.45(0.1)}{0.24}=0.1875,\\qquad N_2=\\frac{0.15(0.1)}{0.24}=0.0625\\\\N_3&=\\frac{0.15(0.3)}{0.24}=0.1875,\\qquad N_4=\\frac{0.3(0.45)}{0.24}=0.5625,\\qquad\\textstyle\\sum N_i=1\\end{aligned}", "em": 44, "color": "#1b2330"}, {"name": "u1_uvp", "tex": "\\begin{aligned}u&=[0.1875(1)+0.0625(2)+0.1875(3)+0.5625(1)]\\times10^{-5}=1.4375\\times10^{-5}\\ \\mathrm{m}\\\\v&=[0.1875(0.1)+0.0625(0.1)+0+0]\\times10^{-5}=2.5\\times10^{-7}\\ \\mathrm{m}\\end{aligned}", "em": 44, "color": "#1b2330"}, {"name": "u1_epsp", "tex": "\\begin{aligned}\\varepsilon_{xx}&=\\frac{0.1(2-1)+0.3(3-1)}{0.24}\\times10^{-5}=2.9167\\times10^{-5}\\\\[4pt]\\varepsilon_{yy}&=\\frac{0.45(0-0.1)+0.15(0-0.1)}{0.24}\\times10^{-5}=-2.5\\times10^{-6}\\\\[4pt]\\varepsilon_{xy}&=\\frac{0.45(1-1)+0.15(3-2)}{0.24}\\times10^{-5}+\\frac{0.1(0.1-0.1)+0.3(0-0)}{0.24}\\times10^{-5}=6.25\\times10^{-6}\\end{aligned}", "em": 44, "color": "#1b2330"}, {"name": "u1_sigp", "tex": "\\begin{Bmatrix}\\sigma_{xx}\\\\\\sigma_{yy}\\\\\\sigma_{xy}\\end{Bmatrix}=219.78\\times10^{6}\\begin{Bmatrix}2.9167\\times10^{-5}-0.3(2.5\\times10^{-6})\\\\0.3(2.9167\\times10^{-5})-2.5\\times10^{-6}\\\\0.35\\,(6.25\\times10^{-6})\\end{Bmatrix}=\\begin{Bmatrix}6245\\\\1374\\\\481\\end{Bmatrix}\\ \\mathrm{kN/m^2}", "em": 44, "color": "#1b2330"}, {"name": "u1_centre_c", "tex": "\\begin{aligned}\\text{centre, }u_3=3\\times10^{-5}:\\quad&\\varepsilon=\\{2.5\\times10^{-5},\\ -2.5\\times10^{-6},\\ 1.25\\times10^{-5}\\}\\\\&\\sigma=\\{5330,\\ 1099,\\ 962\\}\\ \\mathrm{kN/m^2}\\end{aligned}", "em": 44, "color": "#1b2330"}, {"name": "u2_ps", "tex": "\\begin{aligned}\\frac{E}{1-\\nu^2}&=\\frac{30\\times10^{6}}{1-0.04}=31.25\\times10^{6}\\\\\\nu\\,\\frac{E}{1-\\nu^2}&=6.25\\times10^{6},\\qquad\\frac{1-\\nu}{2}\\,\\frac{E}{1-\\nu^2}=12.5\\times10^{6}\\\\[4pt][E]_{\\sigma}&=\\begin{bmatrix}31.25&6.25&0\\\\6.25&31.25&0\\\\0&0&12.5\\end{bmatrix}\\times10^{6}\\ \\mathrm{kN/m^2}\\end{aligned}", "em": 44, "color": "#1b2330"}, {"name": "u2_pe", "tex": "\\begin{aligned}\\frac{E}{(1+\\nu)(1-2\\nu)}&=\\frac{30\\times10^{6}}{1.2\\times0.6}=41.667\\times10^{6}\\\\[4pt][E]_{\\varepsilon}&=41.667\\times10^{6}\\begin{bmatrix}0.8&0.2&0\\\\0.2&0.8&0\\\\0&0&0.3\\end{bmatrix}=\\begin{bmatrix}33.33&8.33&0\\\\8.33&33.33&0\\\\0&0&12.5\\end{bmatrix}\\times10^{6}\\ \\mathrm{kN/m^2}\\end{aligned}", "em": 44, "color": "#1b2330"}, {"name": "u2_G", "tex": "G=\\frac{E}{2(1+\\nu)}=\\frac{30\\times10^{6}}{2.4}=12.5\\times10^{6}\\ \\mathrm{kN/m^2}\\quad\\text{(the same in both)}", "em": 44, "color": "#1b2330"}, {"name": "u2_sig", "tex": "\\begin{aligned}\\text{plane stress: }&\\sigma_{xx}=31.25\\times10^{6}(2\\times10^{-4})=6250\\ \\mathrm{kN/m^2}\\\\&\\sigma_{yy}=6.25\\times10^{6}(2\\times10^{-4})=1250\\ \\mathrm{kN/m^2}\\\\\\text{plane strain: }&\\sigma_{xx}=33.33\\times10^{6}(2\\times10^{-4})=6667\\ \\mathrm{kN/m^2}\\\\&\\sigma_{yy}=8.33\\times10^{6}(2\\times10^{-4})=1667\\ \\mathrm{kN/m^2}\\end{aligned}", "em": 44, "color": "#1b2330"}, {"name": "u2_zz", "tex": "\\begin{aligned}\\text{plane stress: }&\\sigma_{zz}=0,\\qquad\\varepsilon_{zz}=-\\frac{\\nu}{E}(\\sigma_{xx}+\\sigma_{yy})=-\\frac{0.2(7500)}{30\\times10^{6}}=-5.0\\times10^{-5}\\\\\\text{plane strain: }&\\varepsilon_{zz}=0,\\qquad\\sigma_{zz}=\\nu(\\sigma_{xx}+\\sigma_{yy})=0.2(6667+1667)=1667\\ \\mathrm{kN/m^2}\\end{aligned}", "em": 44, "color": "#1b2330"}, {"name": "u3_dofs", "tex": "\\text{node }i:\\ U_i=\\text{dof }2i-1\\ (x),\\quad V_i=\\text{dof }2i\\ (y);\\qquad 16\\text{ nodes}\\ \\Rightarrow\\ [K]\\ 32\\times32", "em": 44, "color": "#1b2330"}, {"name": "u3_known", "tex": "\\begin{aligned}&\\text{left side, nodes }1,5,9,13:\\ u=v=0\\ \\Rightarrow\\ \\text{dofs }1,2,\\ 9,10,\\ 17,18,\\ 25,26\\ \\text{known}\\\\&32-8=24\\text{ unknowns}\\end{aligned}", "em": 44, "color": "#1b2330"}, {"name": "u3_loads", "tex": "\\begin{aligned}r_7&=\\frac{qh}{2},\\quad r_{15}=\\frac{qh}{2}+\\frac{qh}{2}=qh,\\quad r_{23}=qh,\\quad r_{31}=\\frac{qh}{2}\\\\[2pt]\\textstyle\\sum r&=3qh=q\\times\\text{height}\\qquad(\\text{all other entries of }\\{r\\}\\text{ zero})\\end{aligned}", "em": 44, "color": "#1b2330"}, {"name": "u3_rigid", "tex": "\\begin{aligned}u&=-\\theta y,\\quad v=\\theta x:\\qquad\\varepsilon_{xx}=\\frac{\\partial u}{\\partial x}=0,\\quad\\varepsilon_{yy}=\\frac{\\partial v}{\\partial y}=0,\\quad\\varepsilon_{xy}=\\frac{\\partial u}{\\partial y}+\\frac{\\partial v}{\\partial x}=-\\theta+\\theta=0\\end{aligned}", "em": 44, "color": "#1b2330"}]