[{"name": "p6_load", "tex": "\\begin{aligned}\\text{Force: }\\ F_y&=q_y\\,H=(-5000)(2)=-10\\,000\\ \\mathrm{N}\\\\\\text{Pressure: }\\ p_y&=\\frac{q_y}{t}=\\frac{-5000}{0.01}\\\\&=-500\\times10^{3}\\ \\mathrm{N\\,m^{-2}}=-500\\ \\mathrm{kPa}\\end{aligned}", "em": 44, "color": "#1b2330"}, {"name": "p6_load_chk", "tex": "p_y\\times(H\\,t)=(-500\\times10^{3})(2)(0.01)=-10\\,000\\ \\mathrm{N}\\quad\\checkmark", "em": 44, "color": "#1b2330"}, {"name": "p6_size", "tex": "\\begin{aligned}\\text{cantilever: }\\ a&=\\frac{L}{N_x}=\\frac{4}{2}=2\\ \\mathrm{m},\\qquad b=\\frac{H}{N_y}=\\frac{2}{2}=1\\ \\mathrm{m}\\\\\\text{plate: }\\ h&=\\frac{1}{16}=0.0625\\ \\mathrm{m}\\ \\Rightarrow\\ 16\\times16\\end{aligned}", "em": 44, "color": "#1b2330"}, {"name": "p6_heat", "tex": "\\begin{aligned}\\text{generated: }\\ Q\\,A\\,t&=600\\times1\\times t\\ \\mathrm{W}\\\\\\textstyle\\sum\\text{reactions, Temperature edges}&=-600\\,t\\ \\mathrm{W}\\ \\ (\\text{removed})\\end{aligned}", "em": 44, "color": "#1b2330"}, {"name": "p6_plate_err", "tex": "\\begin{aligned}2\\times2:&\\ \\ \\frac{0.6214-0.5897}{0.5897}=+5.4\\%\\\\16\\times16:&\\ \\ \\frac{0.5898-0.5897}{0.5897}=+0.02\\%\\end{aligned}", "em": 44, "color": "#1b2330"}, {"name": "p6_change", "tex": "\\text{change}=\\frac{v_{\\text{fine}}-v_{\\text{coarse}}}{v_{\\text{fine}}}\\times100\\%", "em": 44, "color": "#1b2330"}, {"name": "p6_timo", "tex": "\\begin{aligned}v_{\\text{tip}}&=\\frac{PL^{3}}{3EI}+\\frac{PL}{\\kappa GA}=0.1600+0.0319=0.1919\\ \\mathrm{m}\\\\I&=\\frac{tH^{3}}{12}=6.667\\times10^{-3}\\ \\mathrm{m^{4}},\\quad A=tH=0.02\\ \\mathrm{m^{2}}\\\\G&=\\frac{E}{2(1+\\nu)}=75.19\\times10^{6}\\ \\mathrm{N\\,m^{-2}},\\quad\\kappa=\\tfrac56\\end{aligned}", "em": 44, "color": "#1b2330"}, {"name": "p6_reaction", "tex": "\\begin{aligned}\\textstyle\\sum R_y&=-F_y=+10\\,000\\ \\mathrm{N},\\qquad\\sum R_x=0\\\\M_{\\text{support}}&=P\\,L=10\\,000\\times4=40\\,000\\ \\mathrm{N\\,m}\\end{aligned}", "em": 44, "color": "#1b2330"}, {"name": "p6_beam_mid", "tex": "\\begin{aligned}(2,\\,1.5):\\quad M&=10\\,000\\,(4-2)=20\\,000\\ \\mathrm{N\\,m}\\\\\\sigma_{xx}^{\\text{beam}}&=\\frac{M\\,(y-H/2)}{I}=\\frac{20\\,000\\,(0.5)}{6.667\\times10^{-3}}\\\\&=1500\\ \\mathrm{kN\\,m^{-2}}\\end{aligned}", "em": 44, "color": "#1b2330"}, {"name": "p6_strain_ratio", "tex": "\\begin{aligned}\\frac{v_{\\text{plane strain}}}{v_{\\text{plane stress}}}&\\approx1-\\nu^{2}=0.891\\\\\\text{Q8 }32\\times16:\\ \\ &\\frac{0.1722}{0.1915}=0.899\\end{aligned}", "em": 44, "color": "#1b2330"}, {"name": "p6_thick", "tex": "\\begin{aligned}v_{\\text{tip}}\\propto\\frac1t:\\quad t=1\\ \\mathrm{m}\\ \\Rightarrow\\ v_{\\text{tip}}&=0.001915\\ \\mathrm{m}\\\\\\text{instead of}\\ &\\ 0.1915\\ \\mathrm{m}\\ \\ (t=0.01\\ \\mathrm{m})\\end{aligned}", "em": 44, "color": "#1b2330"}, {"name": "p6_k11", "tex": "\\begin{aligned}k_{11}&=\\bar E\\,t\\Big[\\frac{b}{3a}+\\frac{(1-\\nu)\\,a}{6b}\\Big]\\\\&=2.2444\\times10^{6}\\Big[\\frac16+\\frac{0.67(2)}{6}\\Big]=0.8753\\times10^{6}\\ \\mathrm{N\\,m^{-1}}\\end{aligned}", "em": 44, "color": "#1b2330"}, {"name": "p6_predict", "tex": "\\text{predict}\\ \\rightarrow\\ \\text{run}\\ \\rightarrow\\ \\text{compare}\\ \\rightarrow\\ \\text{explain}\\ \\rightarrow\\ \\text{trust}", "em": 44, "color": "#1b2330"}, {"name": "x1_k", "tex": "\\begin{aligned}a=b=0.5\\ \\mathrm{m}:\\quad[k]&=\\frac{k\\,t}{6}\\begin{bmatrix}4&-1&-2&-1\\\\-1&4&-1&-2\\\\-2&-1&4&-1\\\\-1&-2&-1&4\\end{bmatrix}\\\\&=50\\,[\\,\\cdots]\\ \\mathrm{W\\,{}^{\\circ}C^{-1}}\\quad(k=300,\\ t=1)\\end{aligned}", "em": 44, "color": "#1b2330"}, {"name": "x1_q", "tex": "\\begin{aligned}\\{q\\}^{e}&=\\frac{Q\\,a\\,b\\,t}{4}\\{1,\\,1,\\,1,\\,1\\}^{T}=\\frac{600(0.25)(1)}{4}=37.5\\ \\mathrm{W\\ each}\\\\R_2&=R_6=75,\\quad R_3=37.5,\\quad R_5=150\\ \\mathrm{W}\\end{aligned}", "em": 44, "color": "#1b2330"}, {"name": "x1_sys", "tex": "\\begin{bmatrix}400&-50&-100&-100\\\\-50&200&-100&-50\\\\-100&-100&800&-100\\\\-100&-50&-100&400\\end{bmatrix}\\begin{Bmatrix}T_2\