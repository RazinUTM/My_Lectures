[{"name": "p_sumF", "tex": "\\sum F_x=0,\\qquad\\sum F_y=0", "em": 52, "color": "#1B2330"}, {"name": "p_eqx_full", "tex": "\\sum F_x=\\Big(\\big(\\sigma_{xx}+\\frac{\\partial\\sigma_{xx}}{\\partial x}dx\\big)-\\sigma_{xx}\\Big)dy+\\Big(\\big(\\sigma_{yx}+\\frac{\\partial\\sigma_{yx}}{\\partial y}dy\\big)-\\sigma_{yx}\\Big)dx+f_x\\,dx\\,dy=0", "em": 52, "color": "#1B2330"}, {"name": "p_eqx", "tex": "\\frac{\\partial\\sigma_{xx}}{\\partial x}+\\frac{\\partial\\sigma_{yx}}{\\partial y}+f_x=0", "em": 52, "color": "#1B2330"}, {"name": "p_eqy_full", "tex": "\\sum F_y=\\Big(\\big(\\sigma_{yy}+\\frac{\\partial\\sigma_{yy}}{\\partial y}dy\\big)-\\sigma_{yy}\\Big)dx+\\Big(\\big(\\sigma_{xy}+\\frac{\\partial\\sigma_{xy}}{\\partial x}dx\\big)-\\sigma_{xy}\\Big)dy+f_y\\,dx\\,dy=0", "em": 52, "color": "#1B2330"}, {"name": "p_eqy", "tex": "\\frac{\\partial\\sigma_{xy}}{\\partial x}+\\frac{\\partial\\sigma_{yy}}{\\partial y}+f_y=0", "em": 52, "color": "#1B2330"}, {"name": "p_units", "tex": "\\Big[\\frac{\\partial\\sigma_{xx}}{\\partial x}\\Big]=\\frac{\\mathrm{N/m^2}}{\\mathrm{m}}=\\frac{\\mathrm{N}}{\\mathrm{m^3}}=[\\,f_x\\,]\\qquad\\text{(force per unit volume)}", "em": 52, "color": "#1B2330"}, {"name": "p_matrix", "tex": "\\begin{bmatrix}\\dfrac{\\partial}{\\partial x}&0&\\dfrac{\\partial}{\\partial y}\\\\[10pt]0&\\dfrac{\\partial}{\\partial y}&\\dfrac{\\partial}{\\partial x}\\end{bmatrix}\\begin{Bmatrix}\\sigma_{xx}\\\\\\sigma_{yy}\\\\\\sigma_{xy}\\end{Bmatrix}=\\begin{Bmatrix}-f_x\\\\-f_y\\end{Bmatrix}", "em": 52, "color": "#1B2330"}, {"name": "p_compact", "tex": "[\\partial]\\{\\sigma\\}^T=-\\{f\\}", "em": 52, "color": "#1B2330"}, {"name": "p_dop", "tex": "[\\partial]=\\begin{bmatrix}\\dfrac{\\partial}{\\partial x}&0&\\dfrac{\\partial}{\\partial y}\\\\[10pt]0&\\dfrac{\\partial}{\\partial y}&\\dfrac{\\partial}{\\partial x}\\end{bmatrix}\\quad(2\\times3)", "em": 52, "color": "#1B2330"}, {"name": "p_hooke", "tex": "\\begin{aligned}\\sigma_{xx}&=\\frac{E}{1-\\nu^2}\\,\\varepsilon_{xx}+\\frac{E\\nu}{1-\\nu^2}\\,\\varepsilon_{yy}\\\\[4pt]\\sigma_{yy}&=\\frac{E\\nu}{1-\\nu^2}\\,\\varepsilon_{xx}+\\frac{E}{1-\\nu^2}\\,\\varepsilon_{yy}\\\\[4pt]\\sigma_{xy}&=\\frac{E(1-\\nu)}{2(1-\\nu^2)}\\,\\varepsilon_{xy}\\end{aligned}", "em": 52, "color": "#1B2330"}, {"name": "p_E", "tex": "\\{\\sigma\\}^T=\\begin{Bmatrix}\\sigma_{xx}\\\\\\sigma_{yy}\\\\\\sigma_{xy}\\end{Bmatrix}=\\frac{E}{1-\\nu^2}\\begin{bmatrix}1&\\nu&0\\\\\\nu&1&0\\\\0&0&\\dfrac{1-\\nu}{2}\\end{bmatrix}\\begin{Bmatrix}\\varepsilon_{xx}\\\\\\varepsilon_{yy}\\\\\\varepsilon_{xy}\\end{Bmatrix}=[E]\\{\\varepsilon\\}^T", "em": 52, "color": "#1B2330"}, {"name": "p_Estrain", "tex": "[E]_{\\text{plane strain}}=\\frac{E}{(1+\\nu)(1-2\\nu)}\\begin{bmatrix}1-\\nu&\\nu&0\\\\\\nu&1-\\nu&0\\\\0&0&\\dfrac{1-2\\nu}{2}\\end{bmatrix}", "em": 52, "color": "#1B2330"}, {"name": "p_strain", "tex": "\\varepsilon_{xx}=\\frac{\\partial u}{\\partial x},\\qquad\\varepsilon_{yy}=\\frac{\\partial v}{\\partial y},\\qquad\\varepsilon_{xy}=\\frac{\\partial u}{\\partial y}+\\frac{\\partial v}{\\partial x}", "em": 52, "color": "#1B2330"}, {"name": "p_strain_matrix", "tex": "\\{\\varepsilon\\}^T=\\begin{Bmatrix}\\varepsilon_{xx}\\\\\\varepsilon_{yy}\\\\\\varepsilon_{xy}\\end{Bmatrix}=\\begin{bmatrix}\\dfrac{\\partial}{\\partial x}&0\\\\[8pt]0&\\dfrac{\\partial}{\\partial y}\\\\[8pt]\\dfrac{\\partial}{\\partial y}&\\dfrac{\\partial}{\\partial x}\\end{bmatrix}\\begin{Bmatrix}u\\\\v\\end{Bmatrix}=[\\partial]^T\\{u\\}^T", "em": 52, "color": "#1B2330"}, {"name": "p_sigma_u", "tex": "\\{\\sigma\\}^T=[E]\\,[\\partial]^T\\{u\\}^T", "em": 52, "color": "#1B2330"}, {"name": "p_pde", "tex": "[\\partial]\\,[E]\\,[\\partial]^T\\{u\\}^T=-\\{f\\}", "em": 52, "color": "#1B2330"}, {"name": "p_compare", "tex": "\\{\\partial\\}\\,[E]\\,\\{\\partial\\}^T\\,T=-q_h\\qquad\\longleftrightarrow\\qquad[\\partial]\\,[E]\\,[\\partial]^T\\{u\\}^T=-\\{f\\}", "em": 52, "color": "#1B2330"}, {"name": "p_bx", "tex": "b_x=\\sigma_{xx}\\big|_b\\,n_x+\\sigma_